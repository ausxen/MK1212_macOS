#!/bin/zsh
tool_path="${0:A:h:h}/Resources/mk1212_mac_tool.py"
log_root="${HOME}/Library/Logs/MK1212 Mac Launcher"
mkdir -p "$log_root"
error_log="$log_root/last-launch-error.log"

python_bin=""
for candidate in /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    if [[ -x "$candidate" ]] && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' 2>/dev/null; then
        python_bin="$candidate"
        break
    fi
done

if [[ -z "$python_bin" ]]; then
    /usr/bin/osascript -e 'display alert "MK1212 Mac Launcher" message "Python 3.9 or newer was not found. Install Python, then try again." as critical buttons {"OK"} default button "OK"'
    exit 1
fi

"$python_bin" "$tool_path" launch 2>"$error_log"
exit_code=$?
if (( exit_code != 0 )); then
    message="$(tail -n 8 "$error_log")"
    /usr/bin/osascript -e 'on run argv' -e 'display alert "MK1212 Mac Launcher" message (item 1 of argv) as critical buttons {"OK"} default button "OK"' -e 'end run' "$message"
fi
exit $exit_code

