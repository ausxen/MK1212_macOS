#!/bin/zsh
set -u

container="${0:A:h:h:h:h}"
launcher="$container/MK1212 Mac Launcher.app"
tool="$launcher/Contents/Resources/mk1212_mac_tool.py"
log_root="${HOME}/Library/Logs/MK1212 Mac Launcher"
mkdir -p "$log_root"
error_log="$log_root/last-uninstall-error.log"

if [[ "$container" != "/Applications/MK1212 Mac Launcher" ]]; then
    /usr/bin/osascript -e 'display alert "MK1212 Mac Launcher" message "This uninstaller must be run from /Applications/MK1212 Mac Launcher/." as critical buttons {"OK"}'
    exit 1
fi

if ! /usr/bin/osascript -e 'display dialog "Remove the MK1212 Mac Launcher and its compatibility cache? Workshop packs and the Feral ATTILA application will be left untouched." buttons {"Cancel", "Uninstall"} default button "Cancel" with title "MK1212 Mac Launcher"' >/dev/null 2>&1; then
    exit 0
fi

if ! /usr/bin/pgrep -f "Total War ATTILA.app/Contents/MacOS/Total War ATTILA" >/dev/null 2>&1; then
    :
else
    /usr/bin/osascript -e 'display alert "MK1212 Mac Launcher" message "ATTILA is still running. Close it, then run the uninstaller again." as critical buttons {"OK"}'
    exit 1
fi

if [[ ! -x "$tool" && ! -f "$tool" ]]; then
    /usr/bin/osascript -e 'display alert "MK1212 Mac Launcher" message "The bundled cleanup tool is missing; nothing was removed." as critical buttons {"OK"}'
    exit 1
fi

/usr/bin/python3 "$tool" uninstall 2>"$error_log"
status=$?
if (( status != 0 )); then
    message="$(tail -n 12 "$error_log")"
    /usr/bin/osascript -e 'on run argv' -e 'display alert "MK1212 Mac Launcher" message (item 1 of argv) as critical buttons {"OK"}' -e 'end run' "$message"
    exit $status
fi

# The uninstaller cannot remove its own containing bundle synchronously.
# Delete only the exact installed container after this process exits.
/bin/sh -c 'sleep 1; /bin/rm -rf -- "$1"' _ "$container" >/dev/null 2>&1 &
disown $!
/usr/bin/osascript -e 'display notification "The launcher was removed. Workshop and Feral files were left untouched." with title "MK1212 Mac Launcher"'
exit 0
