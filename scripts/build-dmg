#!/bin/zsh
set -euo pipefail

repo_root="${0:A:h:h}"
version="${VERSION:-0.8.0}"
dist_root="$repo_root/dist"
archive="$dist_root/MK1212_macOS-${version}.dmg"
checksum="$archive.sha256"

if [[ -e "$archive" || -e "$checksum" ]]; then
    print -u2 "Refusing to overwrite an existing release or checksum: $archive"
    exit 1
fi

build_root="$(mktemp -d /private/tmp/mk1212-dmg.XXXXXX)"
clean_root="$build_root/volume"
rw_image="$build_root/volume-rw.dmg"
mountpoint="$build_root/mount"
package="$clean_root/Install MK1212 Mac Launcher.pkg"
trap 'rm -rf "$build_root"' EXIT

mkdir -p "$clean_root" "$mountpoint" "$dist_root"
"$repo_root/scripts/build-package" "$package" >/dev/null
cp "$repo_root/Read_Me_First.txt" "$clean_root/Read_Me_First.txt"
cp "$repo_root/RELEASE-NOTES-0.8.0.md" "$clean_root/RELEASE-NOTES-0.8.0.md"
cp "$repo_root/NOTICE.md" "$clean_root/NOTICE.md"
cp "$repo_root/app/MK1212MacLauncher.icns" "$clean_root/.VolumeIcon.icns"

hdiutil create -size 32m -fs HFS+ -volname "ausxen's MK1212 macOS Launcher" \
    -ov "$rw_image" >/dev/null
hdiutil attach -nobrowse -noverify -mountpoint "$mountpoint" "$rw_image" >/dev/null
ditto --norsrc --noqtn "$clean_root/" "$mountpoint/"
SetFile -a C "$mountpoint"
hdiutil detach "$mountpoint" >/dev/null
hdiutil convert "$rw_image" -format UDZO -o "$archive" >/dev/null

( cd "$dist_root" && shasum -a 256 "${archive:t}" > "${checksum:t}" )
print "$archive"
