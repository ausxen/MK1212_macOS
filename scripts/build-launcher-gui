#!/bin/zsh
set -euo pipefail

repo_root="${0:A:h:h}"
output="${1:-$repo_root/build/mk1212-launcher-gui}"
signing_identity="${CODESIGN_IDENTITY:--}"

mkdir -p "${output:h}"
/usr/bin/xcrun clang \
    -arch arm64 \
    -fobjc-arc \
    -mmacosx-version-min=12.0 \
    -framework AppKit \
    -Wall -Wextra -Werror \
    "$repo_root/src/mk1212_launcher_gui.m" \
    -o "$output"

sign_args=(--force --sign "$signing_identity")
if [[ "$signing_identity" != "-" ]]; then
    sign_args+=(--options runtime --timestamp)
fi
/usr/bin/codesign "${sign_args[@]}" "$output"
/usr/bin/codesign --verify --strict "$output"
print "$output"
